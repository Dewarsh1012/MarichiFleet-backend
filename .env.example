# MarichiFleet Backend - Render Production Environment Variables
# Port is provided automatically by Render (default 10000).
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# CORS: Set to '*' or comma-separated list of your Vercel domains:
# Example: https://marichifleet.vercel.app,https://marichifleet-*.vercel.app
CORS_ORIGIN=*

# JWT Signing Key (Random secure 32+ character string)
JWT_SECRET=production-secret-change-this-to-a-secure-random-key
# Separate 32+ character key for revocable public tracking links.
TRACKING_TOKEN_SECRET=production-tracking-secret-change-this-key

# MongoDB Connection String (MongoDB Atlas or Render Managed database)
# Example: mongodb+srv://<username>:<password>@cluster0.ctm0e27.mongodb.net/marichifleet?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ctm0e27.mongodb.net/marichifleet?retryWrites=true&w=majority

# Google OAuth Client ID (server-side id_token verification requires this to be set)
GOOGLE_CLIENT_ID=116103213980-jbatdnvs5ckpbamneisc4e8g66v0jgba.apps.googleusercontent.com
# Google OAuth secret (only needed if you use server-side OAuth 2.0 code exchange)
GOOGLE_CLIENT_SECRET=

# Microservice Configuration
SERVICE_NAME=core-api
API_PREFIX=/api

# --- Feature Flags ---
# Demo mode is deprecated. Auto-provisioning and persona switch have been removed.
# It cannot be enabled in production. Leave false unless you are running local demos.
DEMO_MODE=false
# Seed-on-boot only runs the idempotent bootstrap (platform tenant + super admin + optional FX).
# It never inserts demo tenants, users, vehicles, trips, approvals or WhatsApp messages.
SEED_ON_BOOT=false

# --- Super Admin bootstrap (single account, env-driven, first-boot only) ---
# Provide these to create the one and only Super Admin on first boot.
# In production the API refuses to boot if SUPERADMIN_EMAIL is set without SUPERADMIN_PASSWORD.
SUPERADMIN_EMAIL=
# Minimum 12 characters. The account is created with mustResetPassword=true.
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin
# Reserved tenant that owns the Super Admin account.
BOOTSTRAP_TENANT_ID=platform
# Insert a base FX rate row (INR) on first boot when none exists. No FX data is inserted otherwise.
FX_BOOTSTRAP=true

# WhatsApp Business Cloud API. Production sends fail closed when credentials are unset.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=marichifleet-webhook-verify
WHATSAPP_APP_SECRET=
# Single-tenant default, or use the JSON phone-number-ID map for multi-tenant routing.
WHATSAPP_TENANT_ID=
WHATSAPP_PHONE_NUMBER_TENANT_MAP=
# Optional approved Meta template names.
WHATSAPP_TEMPLATE_DRIVER_OFFER=
WHATSAPP_TEMPLATE_ETA_UPDATE=
WHATSAPP_TEMPLATE_POD_REMINDER=
WHATSAPP_TEMPLATE_APPROVAL=
WHATSAPP_TEMPLATE_LANGUAGE=en
