# MarichiFleet Backend - Render Production Environment Variables
# Port is provided automatically by Render (default 10000).
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# CORS: Set to '*' or comma-separated list of your Vercel domains:
# Example: https://marichifleet.vercel.app,https://marichifleet-*.vercel.app
CORS_ORIGIN=*

# JWT Signing Key (Random secure 32+ character string)
JWT_SECRET=production-secret-change-this-to-a-secure-random-key

# MongoDB Connection String (MongoDB Atlas or Render Managed MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.ctm0e27.mongodb.net/marichifleet?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ctm0e27.mongodb.net/marichifleet?retryWrites=true&w=majority

# Google OAuth Client ID
GOOGLE_CLIENT_ID=116103213980-jbatdnvs5ckpbamneisc4e8g66v0jgba.apps.googleusercontent.com

# Microservice Configuration
SERVICE_NAME=core-api
API_PREFIX=/api

# Demo mode: allows persona switching and auto-creates users on login (never enable in production)
DEMO_MODE=false

# WhatsApp Business Cloud API (optional — simulated when unset)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=marichifleet-webhook-verify

# Google OAuth secret (required for server-side token verification)
GOOGLE_CLIENT_SECRET=
